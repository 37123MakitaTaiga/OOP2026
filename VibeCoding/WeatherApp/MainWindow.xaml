<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天気予報アプリ"
        Height="850"
        Width="1150"
        MinHeight="800"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F0F3F8">

    <Grid Margin="16">
        <Border Background="#142B4B"
                CornerRadius="18"
                Padding="25">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ヘッダー -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="東京（日本）"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="天気予報"
                                   FontSize="11"
                                   Foreground="#AFC6DF"/>
                    </StackPanel>

                    <Button x:Name="RefreshButton"
                            Grid.Column="1"
                            Content="⟳ 更新"
                            Click="RefreshButton_Click"
                            Width="110"
                            Height="38"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#477DB4"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>

                <!-- 現在の天気 -->
                <Grid Grid.Row="1" Margin="0,15,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 気温カード -->
                    <Border Grid.Column="0"
                            Background="#477DB4"
                            CornerRadius="15"
                            Padding="25"
                            Margin="0,0,8,0">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="現在の天気"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#DCEBFA"/>

                            <TextBlock x:Name="CurrentWeatherIcon"
                                       Text="🌤️"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="75"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="TemperatureText"
                                       Text="-- ℃"
                                       FontSize="46"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="WeatherText"
                                       Text="天気を取得してください"
                                       FontSize="17"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 天気詳細カード -->
                    <Border Grid.Column="1"
                            Background="#31577E"
                            CornerRadius="15"
                            Padding="25"
                            Margin="8,0,0,0">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="天気の詳細"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#C9DDF1"
                                       Margin="0,0,0,18"/>

                            <TextBlock Text="💧 湿度"
                                       Foreground="#BBD3EA"
                                       FontSize="13"/>

                            <TextBlock x:Name="HumidityText"
                                       Text="湿度：-- %"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,4,0,18"/>

                            <TextBlock Text="💨 風速"
                                       Foreground="#BBD3EA"
                                       FontSize="13"/>

                            <TextBlock x:Name="WindSpeedText"
                                       Text="風速：-- m/s"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,4,0,12"/>

                            <TextBlock x:Name="StatusText"
                                       Text="天気情報を取得してください"
                                       Foreground="#DCEBFA"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 7日間の天気予報 -->
                <Border Grid.Row="2"
                        Background="#31577E"
                        CornerRadius="15"
                        Padding="18"
                        Margin="0,5,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="7日間の天気予報"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="最高気温・最低気温"
                                       FontSize="12"
                                       Foreground="#BBD3EA"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">

                            <WrapPanel x:Name="ForecastPanel"
                                       Orientation="Horizontal"
                                       VerticalAlignment="Top"/>

                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>